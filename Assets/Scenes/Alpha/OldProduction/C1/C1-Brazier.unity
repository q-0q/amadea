  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7d20f73aabcb4cfbaac49363662be3e1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  currentDialogueIndex: 0
  textStartOffset: 0
  dialogues:
  - texts:
    - Your presence in this place has summoned the bells.
    - Ring it if you shall. The choice is yours.
    advanceDialogueIndex: 1
    resetDialogueIndex: 0
    canvasDelayOffset: 0
  - texts:
    - Ring it if you shall. The choice is yours.
    advanceDialogueIndex: 0
    resetDialogueIndex: 0
    canvasDelayOffset: 0
  - texts:
    - With the toll, you have set a turning of age into motion.
    advanceDialogueIndex: 1
    resetDialogueIndex: 0
    canvasDelayOffset: 0
  - texts:
    - Her bells are holy totems. Ceuns. Symbols of her will.
    - Each represent a test of faith. Seek them far and wide across the mountain.
    - For them to appear... she sees grand worth within you.
    advanceDialogueIndex: 0
    resetDialogueIndex: 0
    canvasDelayOffset: 0
  DialogueName: Savaphe
  LookAtOverride: {fileID: 886248136}
  CameraY: 0.7
  canvasDelay: 0
  cameraFollowOffsetLerp: 0
