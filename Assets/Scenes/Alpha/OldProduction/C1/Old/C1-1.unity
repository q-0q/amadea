  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7d20f73aabcb4cfbaac49363662be3e1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  currentDialogueIndex: 0
  textStartOffset: 0
  dialogues:
  - texts:
    - ...
    - I would not have believed it possible.
    - You carry a divine spark within you. The mountain bends to your will.
    - ...
    - There is a brazier up ahead.
    - Countless have tried to light it and failed. I hope you are capable of the
      climb.
    advanceDialogueIndex: 1
    resetDialogueIndex: 0
    canvasDelayOffset: 0
  - texts:
    - Do you feel the blizzard changing? It weighs heavier with each passing moment.
    - A turning of the age is upon us.
    advanceDialogueIndex: 1
    resetDialogueIndex: 0
    canvasDelayOffset: 0
  - texts:
    - The tower ahead is a dangerous climb. Keep your wits about you.
    advanceDialogueIndex: 0
    resetDialogueIndex: 0
    canvasDelayOffset: 0
  DialogueName: Savaphe
  LookAtOverride: {fileID: 73881016}
  CameraY: 0.55
  canvasDelay: 0
  cameraFollowOffsetLerp: 0
